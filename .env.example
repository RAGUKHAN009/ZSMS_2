VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
VITE_APPWRITE_DATABASE_ID=YOUR_DATABASE_ID

# TablesDB table IDs
VITE_APPWRITE_TABLE_USERS=user_profiles
VITE_APPWRITE_TABLE_SCOUTS=scouts
VITE_APPWRITE_TABLE_SCOUT_WORKFLOW=scout_workflow
VITE_APPWRITE_TABLE_SCOUT_PROMOTIONS=scout_promotions
VITE_APPWRITE_TABLE_EXPENSES=expenses
VITE_APPWRITE_TABLE_EXPENSE_ITEMS=expense_items
VITE_APPWRITE_TABLE_EXPENSE_FILES=expense_files
VITE_APPWRITE_TABLE_EVENTS=events
VITE_APPWRITE_TABLE_EVENT_EXPENSES=event_expenses
VITE_APPWRITE_TABLE_EVENT_EXPENSE_FILES=event_expense_files
VITE_APPWRITE_TABLE_PROPOSALS=activity_proposals
VITE_APPWRITE_TABLE_NOTIFICATIONS=notifications
VITE_APPWRITE_TABLE_AUDIT_LOGS=audit_logs

# Storage bucket IDs
VITE_APPWRITE_BUCKET_SCOUT_IMAGES=scout-images
VITE_APPWRITE_BUCKET_EXPENSE_BILLS=expense-bills
VITE_APPWRITE_BUCKET_EVENT_BILLS=event-bills
VITE_APPWRITE_BUCKET_DOCUMENTS=documents

# Set to "true" to use the real Appwrite backend instead of in-memory mock data
VITE_USE_APPWRITE=false
